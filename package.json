    "@types/node": "^26.1.1",
    "@vite-pwa/sveltekit": "^1.0.0",
    "sharp": "^0.34.5",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "chessground": "^9.1.1",
    "chessops": "^0.14.0",
